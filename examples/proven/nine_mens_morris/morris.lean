namespace GoLean.«github.com/frederik-jatzkowski/go-lean/examples/proven/nine_mens_morris».Laws

set_option autoImplicit false

def «outsideBoardIsEmpty» : Prop :=
  ∀ b p, 24 ≤ p → «Board$stoneAt» b p = 0

def «countedStones» : Prop :=
  ∀ b player,
  let points := (List.range 24).map UInt64.ofNat
  «Board$count» b player = (points.map (fun p => if «Board$stoneAt» b p = player then 1 else 0)).foldl (· + ·) 0

def «slideAvailability» : Prop :=
  ∀ b player,
  let points := (List.range 24).map UInt64.ofNat
  «Board$hasSlide» b player = points.any (fun f => decide («Board$stoneAt» b f = player) &&
  points.any (fun t => decide («Board$stoneAt» b t = 0) && adjacent f t))

def «movementAvailability» : Prop :=
  ∀ b player, «Board$hasMove» b player = true ↔
  («Board$count» b player = 3 ∧ «Board$count» b 0 ≠ 0) ∨ (3 < «Board$count» b player ∧ «Board$hasSlide» b player = true)

def «millGeometry» : Prop :=
  ∀ board p (player : UInt8), p < 24 → player ≠ 0 →
  let lines : List (List UInt64) := [[0,1,2], [2,3,4], [4,5,6], [6,7,0],
  [8,9,10], [10,11,12], [12,13,14], [14,15,8], [16,17,18], [18,19,20],
  [20,21,22], [22,23,16], [1,9,17], [3,11,19], [5,13,21], [7,15,23]]
  «Board$inMill» board p player = lines.any (fun line => line.contains p && line.all (fun q => «Board$stoneAt» board q == player))

def «unprotectedStones» : Prop :=
  ∀ b player,
  let points := (List.range 24).map UInt64.ofNat
  «Board$hasUnprotected» b player = points.any (fun p => decide («Board$stoneAt» b p = player) && !«Board$inMill» b p player)

def «boardUpdate» : Prop :=
  ∀ b p q player, p < 24 → q < 24 → (p = q → p.toNat < b.«field:points».size) →
  «Board$stoneAt» («Board$setPoint» b p player) q = if q = p then player else «Board$stoneAt» b q

def «boardSnapshot» : Prop :=
  ∀ s, «Game$Board» s = s.«field:board»

def «validTurn» : Prop :=
  ∀ s, «Game$IsValid» s = true ↔ s.«field:turn» = 1 ∨ s.«field:turn» = 2

def «placementPhase» : Prop :=
  ∀ s, «Game$Placing» s = true ↔
  s.«field:whiteReserve» ≠ 0 ∨ s.«field:blackReserve» ≠ 0

def «outcomeRules» : Prop :=
  ∀ s, «Game$Outcome» s =
  if s.«field:pending» = true ∨ s.«field:whiteReserve» ≠ 0 ∨ s.«field:blackReserve» ≠ 0 then 0
  else if «Board$hasMove» s.«field:board» s.«field:turn» = false then (if s.«field:turn» = 1 then 2 else 1)
  else if 50 ≤ s.«field:quiet» then 3 else 0

def «pendingCapture» : Prop :=
  ∀ s, «Game$Pending» s = s.«field:pending»

def «currentTurn» : Prop :=
  ∀ s, «Game$Turn» s = s.«field:turn»

def «captureLegality» : Prop :=
  ∀ s p, let other : UInt8 := if s.«field:turn» = 1 then 2 else 1
  «Game$canCapture» s p = true ↔ «Game$IsValid» s = true ∧ s.«field:pending» = true ∧ p < 24 ∧ «Board$stoneAt» s.«field:board» p = other ∧
  («Board$inMill» s.«field:board» p other = false ∨ «Board$hasUnprotected» s.«field:board» other = false)

def «boardEdges» : Prop :=
  ∀ a b : Fin 24,
  adjacent (UInt64.ofNat a.val) (UInt64.ofNat b.val) =
  decide ((a.val / 8 = b.val / 8 ∧ ((a.val + 1) % 8 = b.val % 8 ∨ (b.val + 1) % 8 = a.val % 8)) ∨
  (a.val % 8 = b.val % 8 ∧ a.val % 2 = 1 ∧ (a.val / 8 + 1 = b.val / 8 ∨ b.val / 8 + 1 = a.val / 8)))

def «movementLegality» : Prop :=
  ∀ s f t, «Game$canMove» s f t = true ↔
  «Game$IsValid» s = true ∧ s.«field:pending» = false ∧ s.«field:whiteReserve» = 0 ∧ s.«field:blackReserve» = 0 ∧ s.«field:quiet» < 50 ∧
  «Board$hasMove» s.«field:board» s.«field:turn» = true ∧ f < 24 ∧ t < 24 ∧
  «Board$stoneAt» s.«field:board» f = s.«field:turn» ∧ «Board$stoneAt» s.«field:board» t = 0 ∧
  («Board$count» s.«field:board» s.«field:turn» = 3 ∨ adjacent f t = true)

def «placementLegality» : Prop :=
  ∀ s p, «Game$canPlace» s p = true ↔
  «Game$IsValid» s = true ∧ s.«field:pending» = false ∧ (if s.«field:turn» = 1 then s.«field:whiteReserve» else s.«field:blackReserve») ≠ 0 ∧
  p < 24 ∧ «Board$stoneAt» s.«field:board» p = 0

def «captureTransition» : Prop :=
  ∀ s p, «Game$capture» s p = if «Game$canCapture» s p then
  let turn := if s.«field:turn» = 1 then 2 else 1
  (ActionResult.mk {s with «field:board» := «Board$setPoint» s.«field:board» p 0, «field:pending» := false, «field:quiet» := 0, «field:turn» := turn} true)
  else ⟨s, false⟩

def «capturePreservesValidity» : Prop :=
  ∀ s p, «Game$IsValid» s = true → «Game$IsValid» («Game$capture» s p).«field:next» = true

def «finishingTurn» : Prop :=
  ∀ s p, «Game$finishAction» s p =
  let other : UInt8 := if s.«field:turn» = 1 then 2 else 1
  if «Board$inMill» s.«field:board» p s.«field:turn» = true ∧ «Board$count» s.«field:board» other ≠ 0
  then {s with «field:pending» := true} else {s with «field:turn» := other}

def «moveTransition» : Prop :=
  ∀ s f t, «Game$move» s f t = if «Game$canMove» s f t then
  let board := «Board$setPoint» («Board$setPoint» s.«field:board» f 0) t s.«field:turn»
  (ActionResult.mk («Game$finishAction» {s with «field:board» := board, «field:quiet» := s.«field:quiet» + 1} t) true) else ⟨s, false⟩

def «movePreservesOpposingStones» : Prop :=
  ∀ s f t p,
  s.«field:turn» = 1 ∨ s.«field:turn» = 2 →
  («Game$move» s f t).«field:accepted» = true → p < 24 →
  «Board$stoneAt» («Game$Board» s) p = opponent s.«field:turn» →
  «Board$stoneAt» («Game$Board» («Game$move» s f t).«field:next») p = opponent s.«field:turn»

def «moveGrantsCaptureExactlyOnMill» : Prop :=
  ∀ s f t, («Game$move» s f t).«field:accepted» = true →
  let next := («Game$move» s f t).«field:next»
  «Game$Pending» next = true ↔
  «Board$inMill» («Game$Board» next) t s.«field:turn» = true ∧
  «Board$count» («Game$Board» next) (opponent s.«field:turn») ≠ 0

def «movePreservesValidity» : Prop :=
  ∀ s f t, «Game$IsValid» s = true → «Game$IsValid» («Game$move» s f t).«field:next» = true

def «placeTransition» : Prop :=
  ∀ s p, «Game$place» s p = if «Game$canPlace» s p then
  let placed := {s with «field:board» := «Board$setPoint» s.«field:board» p s.«field:turn»}
  (ActionResult.mk («Game$finishAction» (if s.«field:turn» = 1 then {placed with «field:whiteReserve» := s.«field:whiteReserve» - 1}
  else {placed with «field:blackReserve» := s.«field:blackReserve» - 1}) p) true)
  else ⟨s, false⟩

def «placePreservesValidity» : Prop :=
  ∀ s p, «Game$IsValid» s = true → «Game$IsValid» («Game$place» s p).«field:next» = true

def «startRules» : Prop :=
  Start.«field:turn» = 1 ∧ Start.«field:whiteReserve» = 9 ∧ Start.«field:blackReserve» = 9 ∧
  Start.«field:pending» = false ∧ Start.«field:quiet» = 0 ∧
  ∀ p, «Board$stoneAt» Start.«field:board» p = 0

def «startIsValid» : Prop :=
  «Game$IsValid» Start = true

end GoLean.«github.com/frederik-jatzkowski/go-lean/examples/proven/nine_mens_morris».Laws
